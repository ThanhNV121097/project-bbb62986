# POSTGRES_USER is local PostgreSQL username for docker compose.
POSTGRES_USER=app

# POSTGRES_PASSWORD is local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# POSTGRES_DB is local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# BACKEND_PORT maps backend service to host.
BACKEND_PORT=8080

# FRONTEND_PORT maps frontend service to host.
FRONTEND_PORT=3000

# NEXT_PUBLIC_API_URL is browser-visible backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
